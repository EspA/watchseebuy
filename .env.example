# Copy to apps/web/.env.local and apps/worker/.env

DATABASE_URL=postgres://waitseebuy:waitseebuy@localhost:5432/waitseebuy
REDIS_URL=redis://localhost:6379

BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# Set to 1 in production while the public site is the coming-soon page.
# Local search and watches stay available when this is unset.
COMING_SOON=

# Optional until first live search
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=sandbox

EPN_CAMPAIGN_ID=
EPN_TOOL_ID=10001

# Magic-link delivery. Empty = log the URL in the web server console.
RESEND_API_KEY=
EMAIL_FROM=WaitSeeBuy <noreply@waitseebuy.com>
