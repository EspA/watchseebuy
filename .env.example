# Copy to apps/web/.env.local, apps/admin/.env.local, and apps/worker/.env

DATABASE_URL=postgres://watchseebuy:watchseebuy@localhost:5432/watchseebuy
REDIS_URL=redis://localhost:6379

BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Admin app (copy this file to apps/admin/.env.local).
# Add Google redirect http://localhost:3001/api/auth/callback/google
ADMIN_BETTER_AUTH_URL=http://localhost:3001
ADMIN_ALLOWED_EMAIL=contact@waitseebuy.com,contact@watchseebuy.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# Set to 1 in production while the public site is the coming-soon page.
# Local search and watches stay available when this is unset.
COMING_SOON=

# Catalog assistant. Cheapest Gemini text model; swap the id when it retires.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional until first live search
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=sandbox

# Partner Browse proxy (The Timeless Vault). Same paths as eBay Browse:
#   GET https://watchseebuy.com/buy/browse/v1/item_summary/search
#   GET https://watchseebuy.com/buy/browse/v1/item/{itemId}
# Authorization: Bearer <this token>. 32+ characters. Comma-separate to rotate.
PARTNER_BROWSE_TOKEN=

# Marketplace User Account Deletion endpoint (required for production keys).
# Token: 32-80 chars, letters/numbers/hyphen/underscore. Same value in the
# eBay Developer Portal. Endpoint must be the exact public HTTPS URL.
EBAY_NOTIFICATION_VERIFICATION_TOKEN=
EBAY_NOTIFICATION_ENDPOINT=http://localhost:3000/api/ebay/account-deletion

# EPN — server-side only. Leave unset in production until software-app approval.
EPN_PUBLISHER_ID=
EPN_CAMPAIGN_ID=
EPN_CAMPAIGN_ID_SEARCH=
EPN_CAMPAIGN_ID_ALERT=
EPN_TOOL_ID=10001

# Magic-link and alert delivery. Empty SMTP_HOST = log the email in the console.
# Local: Mailpit from docker compose (UI http://localhost:8025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=WatchSeeBuy <noreply@watchseebuy.com>
# Google Workspace mailbox (real send). Use an App Password, not the account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=contact@watchseebuy.com
# SMTP_PASS=
# EMAIL_FROM=WatchSeeBuy <contact@watchseebuy.com>
APP_URL=http://localhost:3000

# How often the worker re-polls a shared coverage query. Default 60 minutes.
# Free Trigger-on-change watches use this interval. Premium and Premium+
# watches on a query can poll faster (15 minutes and 5 minutes).
COVERAGE_POLL_MS=3600000
WORKER_INTERVAL_MS=60000

# PayPal subscriptions. Sandbox until PAYPAL_ENV=live.
# Create a webhook for BILLING.SUBSCRIPTION.* pointing at
# {APP_URL}/api/billing/paypal/webhook and set its id here.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
